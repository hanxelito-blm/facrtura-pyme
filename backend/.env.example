# ─────────────────────────────────────────────────
#  VARIABLES DE ENTORNO — Sistema de Facturación
#  Copia este archivo como .env y rellena los valores
# ─────────────────────────────────────────────────

NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=facturacion_db
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña_segura
DB_SSL=false

# Pool (opcional — valores por defecto en db.js)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000

# ── Servidor Express ──────────────────────────────
PORT=3000
